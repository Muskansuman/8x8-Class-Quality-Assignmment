# Copy values into Streamlit Cloud → App settings → Secrets (do not commit real secrets).

# Optional: public URL shown in the app header (paste after deploy)
DEPLOYED_APP_URL = "https://YOUR-APP-NAME.streamlit.app"

# Streamlit Cloud cannot reach localhost Ollama — use OpenAI for hosted demo:
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# Or keep Ollama only for local runs via .env
